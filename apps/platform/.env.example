# Public browser configuration. Obtain these from your Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only inference credential. Never prefix this variable with VITE_.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Optional server aliases; otherwise the API uses the public Supabase values above.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Edition-specific interface; backend configuration remains shared.
VITE_EDITION=2
